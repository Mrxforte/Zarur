<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/exploreFragment">

    <fragment
        android:id="@+id/authHubFragment"
        android:name="com.example.zarur.presentation.auth.AuthHubFragment"
        android:label="AuthHub"
        tools:layout="@layout/fragment_auth_hub">
        <action
            android:id="@+id/action_authHubFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
        <action
            android:id="@+id/action_authHubFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
    </fragment>

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.example.zarur.presentation.auth.SignInFragment"
        android:label="SignIn"
        tools:layout="@layout/fragment_sign_in">
        <action
            android:id="@+id/action_signInFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_signInFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_signInFragment_to_enableLocationFragment"
            app:destination="@id/enableLocationFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.zarur.presentation.auth.SignUpFragment"
        android:label="SignUp"
        tools:layout="@layout/fragment_sign_up">
        <action
            android:id="@+id/action_signUpFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
        <action
            android:id="@+id/action_signUpFragment_to_fillProfileFragment"
            app:destination="@id/fillProfileFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_signUpFragment_to_exploreFragment"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/fillProfileFragment"
        android:name="com.example.zarur.presentation.accountsetup.FillProfileFragment"
        android:label="FillProfile"
        tools:layout="@layout/fragment_fill_profile">
        <action
            android:id="@+id/action_fillProfileFragment_to_exploreFragment"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.zarur.presentation.auth.ForgotPasswordFragment"
        android:label="ForgotPassword"
        tools:layout="@layout/fragment_forgot_password">
        <action
            android:id="@+id/action_forgotPasswordFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.zarur.presentation.auth.ChangePasswordFragment"
        android:label="ChangePassword"
        tools:layout="@layout/fragment_change_password">
        <action
            android:id="@+id/action_changePasswordFragment_to_signInFragment"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/enableLocationFragment"
        android:name="com.example.zarur.presentation.explore.EnableLocationFragment"
        android:label="EnableLocation"
        tools:layout="@layout/fragment_enable_location">
        <action
            android:id="@+id/action_enableLocationFragment_to_exploreFragment"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/enableLocationFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.example.zarur.presentation.explore.ExploreFragment"
        android:label="Explore"
        tools:layout="@layout/fragment_explore">
        <action
            android:id="@+id/action_exploreFragment_to_notificationFragment"
            app:destination="@id/notificationFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_recommendationFragment"
            app:destination="@id/recommendationFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_searchResultsFragment"
            app:destination="@id/searchResultsFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_favoritesFragment"
            app:destination="@id/favoritesFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_sellerDashboardFragment"
            app:destination="@id/sellerDashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchResultsFragment"
        android:name="com.example.zarur.presentation.explore.SearchResultsFragment"
        android:label="SearchResults"
        tools:layout="@layout/fragment_search_results">
        <action
            android:id="@+id/action_searchResultsFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.example.zarur.presentation.explore.NotificationFragment"
        android:label="Notification"
        tools:layout="@layout/fragment_notification" />

    <fragment
        android:id="@+id/recommendationFragment"
        android:name="com.example.zarur.presentation.explore.RecommendationFragment"
        android:label="Recommendation"
        tools:layout="@layout/fragment_recommendation">
        <action
            android:id="@+id/action_recommendationFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.zarur.presentation.favorites.FavoritesFragment"
        android:label="Favorites"
        tools:layout="@layout/fragment_favorites">
        <action
            android:id="@+id/action_favoritesFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/messageFragment"
        android:name="com.example.zarur.presentation.message.MessageFragment"
        android:label="Message"
        tools:layout="@layout/fragment_message">
        <action
            android:id="@+id/action_messageFragment_to_chatDetailFragment"
            app:destination="@id/chatDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatDetailFragment"
        android:name="com.example.zarur.presentation.message.ChatDetailFragment"
        android:label="ChatDetail"
        tools:layout="@layout/fragment_chat_detail">
        <action
            android:id="@+id/action_chatDetailFragment_to_voiceCallFragment"
            app:destination="@id/voiceCallFragment" />
        <action
            android:id="@+id/action_chatDetailFragment_to_videoCallFragment"
            app:destination="@id/videoCallFragment" />
    </fragment>

    <fragment
        android:id="@+id/voiceCallFragment"
        android:name="com.example.zarur.presentation.message.VoiceCallFragment"
        android:label="VoiceCall"
        tools:layout="@layout/fragment_voice_call" />

    <fragment
        android:id="@+id/videoCallFragment"
        android:name="com.example.zarur.presentation.message.VideoCallFragment"
        android:label="VideoCall"
        tools:layout="@layout/fragment_video_call" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.zarur.presentation.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profileFragment_to_sellerDashboardFragment"
            app:destination="@id/sellerDashboardFragment" />
        <action
            android:id="@+id/action_profileFragment_to_myBookingsFragment"
            app:destination="@id/myBookingsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_paymentsFragment"
            app:destination="@id/paymentsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_notificationsSettingsFragment"
            app:destination="@id/notificationsSettingsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_securityFragment"
            app:destination="@id/securityFragment" />
        <action
            android:id="@+id/action_profileFragment_to_languageFragment"
            app:destination="@id/languageFragment" />
        <action
            android:id="@+id/action_profileFragment_to_helpCenterFragment"
            app:destination="@id/helpCenterFragment" />
        <action
            android:id="@+id/action_profileFragment_to_inviteFriendsFragment"
            app:destination="@id/inviteFriendsFragment" />
    </fragment>

    <fragment
        android:id="@+id/sellerDashboardFragment"
        android:name="com.example.zarur.presentation.seller.SellerDashboardFragment"
        android:label="SellerDashboard"
        tools:layout="@layout/fragment_seller_dashboard">
        <action
            android:id="@+id/action_sellerDashboardFragment_to_createProductFragment"
            app:destination="@id/createProductFragment" />
    </fragment>

    <fragment
        android:id="@+id/createProductFragment"
        android:name="com.example.zarur.presentation.seller.CreateProductFragment"
        android:label="CreateProduct"
        tools:layout="@layout/fragment_create_product" />

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.zarur.presentation.profile.EditProfileFragment"
        android:label="EditProfile"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/myBookingsFragment"
        android:name="com.example.zarur.presentation.profile.MyBookingsFragment"
        android:label="MyBookings"
        tools:layout="@layout/fragment_my_bookings" />

    <fragment
        android:id="@+id/paymentsFragment"
        android:name="com.example.zarur.presentation.profile.PaymentsFragment"
        android:label="Payments"
        tools:layout="@layout/fragment_payments" />

    <fragment
        android:id="@+id/notificationsSettingsFragment"
        android:name="com.example.zarur.presentation.profile.NotificationsSettingsFragment"
        android:label="NotificationsSettings"
        tools:layout="@layout/fragment_notifications_settings" />

    <fragment
        android:id="@+id/securityFragment"
        android:name="com.example.zarur.presentation.profile.SecurityFragment"
        android:label="Security"
        tools:layout="@layout/fragment_security">
        <action
            android:id="@+id/action_securityFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />
        <action
            android:id="@+id/action_securityFragment_to_changePinFragment"
            app:destination="@id/changePinFragment" />
    </fragment>

    <fragment
        android:id="@+id/changePinFragment"
        android:name="com.example.zarur.presentation.profile.ChangePinFragment"
        android:label="ChangePin"
        tools:layout="@layout/fragment_change_pin" />

    <fragment
        android:id="@+id/languageFragment"
        android:name="com.example.zarur.presentation.profile.LanguageFragment"
        android:label="Language"
        tools:layout="@layout/fragment_language" />

    <fragment
        android:id="@+id/helpCenterFragment"
        android:name="com.example.zarur.presentation.profile.HelpCenterFragment"
        android:label="HelpCenter"
        tools:layout="@layout/fragment_help_center" />

    <fragment
        android:id="@+id/inviteFriendsFragment"
        android:name="com.example.zarur.presentation.profile.InviteFriendsFragment"
        android:label="InviteFriends"
        tools:layout="@layout/fragment_invite_friends" />

    <!-- Details & Booking Flow -->
    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.example.zarur.presentation.details.ProductDetailFragment"
        android:label="ProductDetail"
        tools:layout="@layout/fragment_product_detail">
        <argument
            android:name="productId"
            app:argType="string" />
        <action
            android:id="@+id/action_productDetailFragment_to_bookRealEstateFragment"
            app:destination="@id/bookRealEstateFragment" />
        <action
            android:id="@+id/action_productDetailFragment_to_leaveReviewFragment"
            app:destination="@id/leaveReviewFragment" />
        <action
            android:id="@+id/action_productDetailFragment_to_sellerStoreFragment"
            app:destination="@id/sellerStoreFragment" />
    </fragment>

    <fragment
        android:id="@+id/sellerStoreFragment"
        android:name="com.example.zarur.presentation.seller.SellerStoreFragment"
        android:label="SellerStore"
        tools:layout="@layout/fragment_seller_store">
        <argument
            android:name="sellerId"
            app:argType="string" />
        <argument
            android:name="sellerName"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/bookRealEstateFragment"
        android:name="com.example.zarur.presentation.booking.BookRealEstateFragment"
        android:label="BookRealEstate"
        tools:layout="@layout/fragment_book_real_estate">
        <action
            android:id="@+id/action_bookRealEstateFragment_to_bookingInfoFragment"
            app:destination="@id/bookingInfoFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingInfoFragment"
        android:name="com.example.zarur.presentation.booking.BookingInfoFragment"
        android:label="BookingInfo"
        tools:layout="@layout/fragment_booking_info">
        <action
            android:id="@+id/action_bookingInfoFragment_to_selectPaymentFragment"
            app:destination="@id/selectPaymentFragment" />
    </fragment>

    <fragment
        android:id="@+id/selectPaymentFragment"
        android:name="com.example.zarur.presentation.booking.SelectPaymentFragment"
        android:label="SelectPayment"
        tools:layout="@layout/fragment_select_payment">
        <action
            android:id="@+id/action_selectPaymentFragment_to_reviewSummaryFragment"
            app:destination="@id/reviewSummaryFragment" />
    </fragment>

    <fragment
        android:id="@+id/reviewSummaryFragment"
        android:name="com.example.zarur.presentation.booking.ReviewSummaryFragment"
        android:label="ReviewSummary"
        tools:layout="@layout/fragment_review_summary">
        <action
            android:id="@+id/action_reviewSummaryFragment_to_bookingPinFragment"
            app:destination="@id/bookingPinFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingPinFragment"
        android:name="com.example.zarur.presentation.booking.BookingPinFragment"
        android:label="BookingPin"
        tools:layout="@layout/fragment_booking_pin">
        <action
            android:id="@+id/action_bookingPinFragment_to_bookingStatusFragment"
            app:destination="@id/bookingStatusFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingStatusFragment"
        android:name="com.example.zarur.presentation.booking.BookingStatusFragment"
        android:label="BookingStatus"
        tools:layout="@layout/fragment_booking_status">
        <action
            android:id="@+id/action_bookingStatusFragment_to_EReceiptFragment"
            app:destination="@id/EReceiptFragment" />
        <action
            android:id="@+id/action_bookingStatusFragment_to_exploreFragment"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/EReceiptFragment"
        android:name="com.example.zarur.presentation.booking.EReceiptFragment"
        android:label="EReceipt"
        tools:layout="@layout/fragment_e_receipt">
        <action
            android:id="@+id/action_EReceiptFragment_to_leaveReviewFragment"
            app:destination="@id/leaveReviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/leaveReviewFragment"
        android:name="com.example.zarur.presentation.booking.LeaveReviewFragment"
        android:label="LeaveReview"
        tools:layout="@layout/fragment_leave_review">
        <argument
            android:name="productId"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_leaveReviewFragment_to_exploreFragment"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
