<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Professional Premium Dark application theme. -->
    <style name="Theme.Zarur.Starting" parent="Theme.Zarur" />

    <style name="Base.Theme.Zarur" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main theme colors -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/dark_on_surface_variant</item>
        <item name="colorOutline">@color/dark_outline</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <!-- Modern Icon Container Styles - Larger & Luxury Black -->
    <style name="Widget.App.IconContainer" parent="">
        <item name="android:layout_width">@dimen/icon_size_56</item>
        <item name="android:layout_height">@dimen/icon_size_56</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:padding">16dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.App.IconContainer.Primary" parent="Widget.App.IconContainer">
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="Widget.App.IconContainer.Surface" parent="Widget.App.IconContainer">
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/dark_surface_variant</item>
        <item name="chipStrokeColor">@color/dark_outline</item>
        <item name="android:textColor">@color/dark_on_surface</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <!-- CalendarView Styles -->
    <style name="CalendarDateText" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/dark_on_surface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalendarWeekDayText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalendarHeaderMonthText" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/dark_on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
